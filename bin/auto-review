#!/usr/bin/env bash
# Host CLI wrapper for the pr-auto-review machine container.
set -euo pipefail

_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _dir=$(cd "$(dirname "$_self")" && pwd)
  _self=$(readlink "$_self")
  case $_self in /*) ;; *) _self=$_dir/$_self ;; esac
done
REPO_DIR=$(cd "$(dirname "$_self")/.." && pwd)
GATE_UID="${AUTO_REVIEW_GATE_UID:-10001}"
CONTAINER="${AUTO_REVIEW_CONTAINER:-auto-review}"

cmd=${1:-}
case "$cmd" in
  -h|--help|help)
    cat <<'HELP'
Usage: bin/auto-review <command> [args...]

Host commands:
  up [-d]                 Start the pr-auto-review container via docker compose
  down                    Stop and remove the pr-auto-review container
  logs [-f]               Follow container logs
  probe                   Verify the auto-review:local image environment
  unlock-token [args...]  Pipe a token from stdin into the running container tmpfs

Container commands (delegated to uid 10001 inside the container):
  setup <owner/repo>      Register, clone, and verify a repository
  list                    List registered repositories and pause states
  pause|resume <repo>     Pause or resume automated reviews for a repository
  tick [path]             Run one review pass across active repositories (or one checkout)
  credential set|list     Store or check harness credentials (stdin)
  login <harness>         Run interactive harness login and store credential
  status [--json]         Print daemon and active review status
HELP
    exit 0
    ;;
  up|down|logs)
    shift
    exec docker compose -f "$REPO_DIR/docker-compose.yml" "$cmd" "$@"
    ;;
  probe)
    exec docker run --rm auto-review:local probe
    ;;
  unlock-token)
    shift
    exec "$REPO_DIR/unlock-token.sh" "$@"
    ;;
  *)
    if [ -t 0 ] && [ -t 1 ]; then
      exec docker exec -it -u "$GATE_UID" "$CONTAINER" auto-review "$@"
    else
      exec docker exec -i -u "$GATE_UID" "$CONTAINER" auto-review "$@"
    fi
    ;;
esac
